# Database
# Local dev: a local Postgres (citext extension required).
#   postgresql://postgres:postgres@localhost:5432/koos
# Production: any cloud Postgres (Neon / Aiven / Vercel Postgres).
DATABASE_URL=

# Migrations (drizzle-kit). Optional — falls back to DATABASE_URL if unset.
# Use a direct (non-pooled) connection in production if your provider pools.
DIRECT_URL=

# Auth — Google OAuth (sign in with Google)
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: ${NEXT_PUBLIC_APP_URL}/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Storage — Cloudflare R2 (S3-compatible)
# Serves brand logos, design deliverables, and AI-generated images.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public/custom domain that serves objects in the bucket (used for logo URLs
# and AI-generated image previews/references).
#   e.g. https://assets.yourdomain.com  or  https://pub-xxxx.r2.dev
R2_PUBLIC_BASE_URL=

# ── AI text models (provider-agnostic via the Vercel AI SDK) ──────────
# Pick the active provider + model for the whole app:
#   AI_PROVIDER one of: google | zai | openai | anthropic | bedrock | openai-compatible
AI_PROVIDER=google
AI_MODEL=gemini-2.5-flash
# Optional per-feature overrides. Features: CHAT, STRATEGY, BRAND.
# A per-feature MODEL always wins. A per-feature PROVIDER that differs from
# AI_PROVIDER ignores the global AI_MODEL and falls back to that provider's
# own default — so switching one feature's provider without naming a model
# does NOT silently reuse the other provider's model id.
# AI_CHAT_PROVIDER=
# AI_CHAT_MODEL=
# AI_STRATEGY_PROVIDER=
# AI_STRATEGY_MODEL=
# AI_BRAND_PROVIDER=
# AI_BRAND_MODEL=
#
# Provide the key for whichever provider(s) you use:
ZAI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Google has TWO credential shapes and the app prefers Vertex when it is fully
# configured (all three of PROJECT / CLIENT_EMAIL / PRIVATE_KEY present):
#   1. Vertex AI, via a service account — the only surface that draws the
#      Google Cloud trial credit. GOOGLE_PRIVATE_KEY holds the PEM with
#      literal \n escapes; the app unescapes them.
#   2. AI Studio, via a plain API key — simpler, but NOT covered by the credit.
# GOOGLE_VERTEX_PROJECT=
# GOOGLE_CLIENT_EMAIL=
# GOOGLE_PRIVATE_KEY=
# Defaults to "global", which is the ONLY location the Gemini 3 line serves
# from — the preflight warns if you set anything else.
# GOOGLE_VERTEX_LOCATION=global
GOOGLE_GENERATIVE_AI_API_KEY=
# Generic OpenAI-compatible endpoint (other Chinese models, gateways, etc.)
# Used only when a provider above is set to "openai-compatible".
AI_COMPATIBLE_BASE_URL=
AI_COMPATIBLE_API_KEY=
AI_COMPATIBLE_NAME=

# ── Amazon Bedrock (AI provider) ──────────────────────────────────────
# To route text AI through Amazon Bedrock, set AI_PROVIDER=bedrock (or a
# per-feature override like AI_CHAT_PROVIDER=bedrock) and provide the exact
# model id / inference-profile id enabled in your AWS account (NO default):
#   AI_PROVIDER=bedrock
#   AI_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0   # example — use YOUR enabled model
# Bedrock authenticates with AWS credentials (not an API key). These are also
# required for AI image generation (below) regardless of the text provider:
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional, only for temporary STS credentials:
# AWS_SESSION_TOKEN=
# IAM permissions the principal needs:
#   - bedrock:InvokeModel + bedrock:InvokeModelWithResponseStream
#   - For Marketplace-delivered models (e.g. Stability image models):
#     aws-marketplace:ViewSubscriptions + aws-marketplace:Subscribe
#     (the console "Model access" grant alone is NOT enough for an app user)
# Each model must also be enabled in the Bedrock console (Model access) in
# the region it is invoked from.
#
# DO NOT SET: AWS_BEARER_TOKEN_BEDROCK. If present it overrides the SigV4
# keys above and breaks all Bedrock calls with "Forbidden". Leave it unset.

# ── AI image generation (design-request "Generate with AI") ───────────
# There is NO provider switch here. The adapter is chosen by what is
# configured, first match wins, in this order:
#   1. Bedrock/Stability  — when AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY are set
#   2. Google             — when the Google credentials above are set
#   3. OpenAI             — when OPENAI_API_KEY is set
# So a deployment with AWS credentials generates images through Bedrock
# whether or not its TEXT provider is Bedrock.
#
# Bedrock/Stability. Region can differ from AWS_REGION (the Stability image
# models live in us-west-2).
#   stability.stable-image-core-v1:1  (fast/cheap, default)
#   stability.stable-image-ultra-v1:1 (higher quality, pricier)
# AI_IMAGE_MODEL=stability.stable-image-core-v1:1
# AI_IMAGE_REGION=us-west-2
#
# Google image model. 2K is the default size; drop to 1K to bisect latency —
# 2K has been measured between 55s and 663s per image against a 300s job
# budget. Anything other than 1K / 2K / 4K is ignored with a warning.
# AI_DESIGN_GOOGLE_MODEL=gemini-3-pro-image
# AI_DESIGN_GOOGLE_IMAGE_SIZE=2K
#
# OpenAI image model.
# AI_DESIGN_OPENAI_MODEL=

# ── Voice (AI brand onboarding — speech input / spoken replies) ───────
# Default "browser" uses the free Web Speech API (no key, Chrome-first).
# Server-side providers are scaffolded for later; leave as browser for now.
# AI_STT_PROVIDER=browser
# AI_TTS_PROVIDER=browser

# ── Analytics — PostHog ───────────────────────────────────────────────
# Both client and server events use the same project key. A silent no-op
# when the key is unset (safe to leave empty in local dev).
#   Key:  PostHog → Settings → Project → "Project API key" (starts phc_...)
#         This is a public, client-exposed key by design — hence NEXT_PUBLIC_.
#   Host: https://us.i.posthog.com (US cloud, default)
#         https://eu.i.posthog.com (EU cloud — use if your PostHog URL is eu.posthog.com)
# This exact name or nothing: every reader no-ops silently when it is
# absent, so a misspelling deploys green and collects zero events.
# `pnpm build` fails on any NEXT_PUBLIC_* variable no source file reads.
NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Email — Zoho Mail (SMTP) ──────────────────────────────────────────
# ZOHO_SMTP_PASS must be a Zoho app password (not the account password), and
# ZOHO_MAIL_FROM must be the mailbox address or a registered Zoho alias —
# otherwise Zoho rejects with 553 relay-denied.
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_SECURE=true
ZOHO_SMTP_USER=
ZOHO_SMTP_PASS=
# Optional. Leave COMMENTED OUT unless it is a registered alias of the mailbox
# above — a blank or non-alias value is rejected on send, not on connect.
# ZOHO_MAIL_FROM=

# Design team inbox that receives new design-request notifications.
# Optional — falls back to ZOHO_MAIL_FROM / ZOHO_SMTP_USER.
DESIGN_TEAM_EMAIL=

# Landing-page contact form inbox (defaults to hello@kocontentstudios.com)
# CONTACT_EMAIL=

# App
# Public origin of the app — used for OAuth redirects, email links and
# absolute asset URLs. Set it explicitly in production.
# When unset, the app falls back to Vercel's own values, in order:
# VERCEL_PROJECT_PRODUCTION_URL, then VERCEL_BRANCH_URL (preview/branch
# deploys). Both are injected by the platform; never declare them yourself.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Build / preflight knobs (optional, local + CI) ────────────────────
# The build runs a preflight (DB, migrations, AI, R2 checks). Skip pieces
# when intentionally building without live services:
# SKIP_PREFLIGHT=1     # skip the whole preflight
# SKIP_DB_CHECK=1
# SKIP_MIGRATIONS=1
# SKIP_AI_CHECK=1
# AI_SKIP_PING=1       # verify AI config without a live model call
# SKIP_R2_CHECK=1
# SKIP_PUBLIC_ENV_CHECK=1   # skip the orphaned-NEXT_PUBLIC_* guard
