{
  "name": "koos",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/migrate.mjs && node scripts/check-env.mjs && node scripts/fetch-fonts.mjs && next build",
    "preflight": "node scripts/check-env.mjs",
    "fonts": "node scripts/fetch-fonts.mjs",
    "start": "next start",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "backup": "node scripts/backup-db.mjs",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "eval:design": "tsx src/lib/ai/image/eval/run.mts",
    "eval:design-logo": "tsx src/lib/ai/image/eval/run-logo.mts",
    "eval:design-spec": "tsx src/lib/ai/design-spec/eval/run.mts",
    "eval:onboarding": "tsx src/lib/ai/onboarding/eval/run.mts",
    "eval:strategy": "tsx src/lib/ai/strategy/eval/run.mts"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "4.0.178",
    "@ai-sdk/anthropic": "3.0.118",
    "@ai-sdk/google": "3.0.124",
    "@ai-sdk/google-vertex": "4.0.201",
    "@ai-sdk/openai": "3.0.114",
    "@ai-sdk/openai-compatible": "2.0.75",
    "@ai-sdk/react": "^3.0.289",
    "@aws-sdk/client-s3": "^3.1136.0",
    "@aws-sdk/s3-request-presigner": "^3.1136.0",
    "@base-ui/react": "^1.8.0",
    "@node-rs/argon2": "^2.2.1",
    "@tanstack/react-query": "^5.103.1",
    "ai": "^6.0.286",
    "arctic": "^3.7.0",
    "aws4fetch": "^1.0.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.3",
    "jszip": "^3.10.2",
    "lucide-react": "^1.47.0",
    "mammoth": "^1.12.3",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "nodemailer": "^10.0.10",
    "nuqs": "^2.10.1",
    "postgres": "^3.4.9",
    "posthog-js": "^1.434.2",
    "posthog-node": "^5.52.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@aws-sdk/lib-storage": "^3.1136.0",
    "@biomejs/biome": "^2.5.14",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
