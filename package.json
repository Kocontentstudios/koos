{
  "name": "koos",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/migrate.mjs && node scripts/check-env.mjs && node scripts/fetch-fonts.mjs && next build",
    "preflight": "node scripts/check-env.mjs",
    "fonts": "node scripts/fetch-fonts.mjs",
    "start": "next start",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "backup": "node scripts/backup-db.mjs",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "e2e:contrast": "playwright test --project=probe --project=contrast --project=server-log",
    "eval:design": "tsx src/lib/ai/image/eval/run.mts",
    "eval:design-logo": "tsx src/lib/ai/image/eval/run-logo.mts",
    "eval:design-spec": "tsx src/lib/ai/design-spec/eval/run.mts",
    "eval:design-benchmark": "tsx src/lib/ai/design-spec/eval/benchmark.mts",
    "eval:design-brief": "tsx src/lib/ai/design-brief/eval/run.mts",
    "eval:design-judge": "tsx src/lib/ai/design-judge/eval/run.mts",
    "eval:design-directions": "tsx src/lib/ai/design-directions/eval/run.mts",
    "eval:onboarding": "tsx src/lib/ai/onboarding/eval/run.mts",
    "eval:scanned-pdf": "tsx src/lib/ai/onboarding/eval/run-scanned.mts",
    "eval:strategy": "tsx src/lib/ai/strategy/eval/run.mts",
    "bench:reencode": "tsx scripts/bench-reencode.mts",
    "eval:subject-check": "tsx scripts/eval-subject-check.mts",
    "eval:subject-parity": "tsx scripts/eval-subject-parity.mts",
    "bench:document-cost": "tsx scripts/bench-document-cost.mts"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "4.0.205",
    "@ai-sdk/anthropic": "3.0.136",
    "@ai-sdk/google": "3.0.140",
    "@ai-sdk/google-vertex": "4.0.223",
    "@ai-sdk/openai": "3.0.135",
    "@ai-sdk/openai-compatible": "2.0.88",
    "@ai-sdk/react": "^3.0.322",
    "@aws-sdk/client-s3": "^3.1160.0",
    "@aws-sdk/s3-request-presigner": "^3.1160.0",
    "@base-ui/react": "^1.9.0",
    "@node-rs/argon2": "^2.2.2",
    "@tanstack/react-query": "^5.105.0",
    "ai": "^6.0.319",
    "arctic": "^3.7.0",
    "aws4fetch": "^1.0.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3",
    "jszip": "^3.10.2",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^1.64.0",
    "mammoth": "^1.13.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "nodemailer": "^10.3.1",
    "nuqs": "^2.10.2",
    "postgres": "^3.4.9",
    "posthog-js": "^1.442.1",
    "posthog-node": "^5.60.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "saxes": "6.0.0",
    "sharp": "0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.9.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@aws-sdk/lib-storage": "^3.1160.0",
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "^2.6.4",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^6",
    "vitest": "^5.0.5"
  }
}
